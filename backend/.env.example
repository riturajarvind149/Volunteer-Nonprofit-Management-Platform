# ============================================================
# Core
# ============================================================
PORT=5000
# 'production' | 'development' | 'test'
NODE_ENV=development
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/volunteer_db
# Use a long random value (>= 32 chars in production), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime (sessions can also be revoked: password change, logout-all, suspension)
# JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS). The first one is used for links in emails.
FRONTEND_URL=http://localhost:5173
# Optional explicit public URL of the frontend for email links (defaults to first FRONTEND_URL)
# APP_URL=https://volunteer-nonprofit-frontend.vercel.app
# APP_NAME=ServeHub

# ============================================================
# Database
# ============================================================
# SSL is enabled automatically in production; override with true/false.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_CA_CERT=
# DATABASE_POOL_MAX=10
# Migrations run automatically on start; set to true to run them separately (npm run migrate)
# SKIP_MIGRATIONS=false

# ============================================================
# Email (SMTP) — works with Resend, SendGrid, Brevo, Mailgun, SES, Gmail app passwords...
# Without SMTP_HOST, emails are written to the server log instead of being sent.
# ============================================================
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="ServeHub <no-reply@yourdomain.org>"

# ============================================================
# Platform policies
# ============================================================
# Users must confirm their email before logging in
# REQUIRE_EMAIL_VERIFICATION=true
# Organizations must be approved by an ADMIN before publishing opportunities
# REQUIRE_ORG_APPROVAL=true

# ============================================================
# Background jobs
# ============================================================
# Time zone used for event times, check-in windows and reminders
# APP_TIMEZONE=Asia/Kolkata
# OPPORTUNITY_COMPLETION_INTERVAL_MS=60000
# REMINDER_INTERVAL_MS=300000
# Hours before an event to send the reminder email
# REMINDER_LEAD_HOURS=24
# DISABLE_SCHEDULER=false

# ============================================================
# Operations
# ============================================================
# LOG_LEVEL=info
# Number of reverse proxies in front of the app (Render/Railway/Heroku = 1)
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_ENABLED=true

# ============================================================
# First admin account (used only by `npm run create-admin`)
# ============================================================
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Platform Admin
