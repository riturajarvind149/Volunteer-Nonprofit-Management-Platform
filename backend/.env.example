PORT=
DATABASE_URL=
NODE_ENV=
JWT_SECRET=
# Comma-separated list of allowed frontend origins
# e.g. https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=
# Application timezone (optional, defaults to runtime timezone or Asia/Kolkata)
# APP_TIMEZONE=Asia/Kolkata
# Opportunity auto-completion scheduler interval in ms (optional, defaults to 60000)
# OPPORTUNITY_COMPLETION_INTERVAL_MS=60000
# Disable background scheduler (optional, defaults to false)
# DISABLE_SCHEDULER=false
