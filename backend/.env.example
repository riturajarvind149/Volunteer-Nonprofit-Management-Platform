PORT=
DATABASE_URL=
# Environment: 'production' or 'development'
NODE_ENV=
# PostgreSQL SSL mode: 'true' enables SSL, 'false' disables SSL.
# In production (NODE_ENV=production), SSL is enabled by default for managed databases (e.g. Render).
# In development/test, SSL is disabled by default unless DATABASE_SSL='true'.
# DATABASE_SSL=true
# Enforce strict CA certificate validation: 'true' requires valid trusted cert.
# Defaults to false in production to support managed cloud providers using self-signed cert chains.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional custom CA certificate string or path for strict SSL verification
# DATABASE_CA_CERT=
JWT_SECRET=
# Comma-separated list of allowed frontend origins
# e.g. https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=
# Application timezone (optional, defaults to runtime timezone or Asia/Kolkata)
# APP_TIMEZONE=Asia/Kolkata
# Opportunity auto-completion scheduler interval in ms (optional, defaults to 60000)
# OPPORTUNITY_COMPLETION_INTERVAL_MS=60000
# Disable background scheduler (optional, defaults to false)
# DISABLE_SCHEDULER=false
