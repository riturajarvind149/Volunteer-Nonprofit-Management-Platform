# Backend API base URL (without /api).
# Local development: must match PORT in backend/.env (5000 in backend/.env.example)
VITE_API_URL=http://localhost:5000

# Production: set this in Vercel → Project → Settings → Environment Variables,
# then redeploy (the value is built into the site at build time):
# VITE_API_URL=https://volunteer-nonprofit-backend.onrender.com
